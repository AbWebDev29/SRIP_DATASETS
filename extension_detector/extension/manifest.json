{
  "manifest_version": 3,
  "name": "Phishing Shield",
  "version": "1.3",
  "description": "Automated Real-Time ML URL checking matrix.",
  "permissions": [
  "tabs",
  "activeTab"
  ],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}